#!/usr/bin/env bash
#
# stride — one command for the whole machine.
#
#   stride              start everything (this is the whole thing)
#   stride status       what is up, what is not
#   stride down         stop the console and the bridge
#   stride install      start it all at login, and link this command
#   stride logs         tail everything at once
#
# `stride install` drops a symlink in ~/.local/bin, so it is typed from
# anywhere. Bare `stride` starts rather than reports, and is safe to repeat:
# it checks each part and only starts what is down.
#
# There are four moving parts and they fail independently, which is why this
# reports each one rather than printing "started" and hoping:
#
#   console        Next.js on :3000. The app itself.
#   funnel         Tailscale publishing :3000 to the internet, on a real
#                  certificate. Runs from a system daemon, so it survives a
#                  reboot without help.
#   bridge         The loopback API that owns the debugger connection to
#                  Linked Helper. Without it the campaign pages go quiet.
#   linked helper  The app, launched with a debugger port. Without the port
#                  the bridge can see nothing.
#
# Nothing here is reachable when the Mac is off. The console is served from
# this machine and the data lives on its disk.

set -uo pipefail

# Resolve symlinks before working out where the repo is. Typed as `stride`
# this file is reached through ~/.local/bin/stride, and taking dirname of that
# would put the root at ~/.local: status would still pass, because its checks
# are all HTTP, while up and install quietly looked for a repo that was not
# there.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink "$SELF")"
  [[ "$LINK" == /* ]] && SELF="$LINK" || SELF="$(dirname "$SELF")/$LINK"
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$ROOT"

BRIDGE_PORT=7455
CONSOLE_PORT=3000
LH_APP="/Applications/linked-helper.app"
LH_DEBUG_PORT=9222
PUBLIC_URL="https://mac-mini.tailc91701.ts.net"

# Every launchd job this repo owns. One list, so a job cannot be installed but
# never reported — com.stride.seo was missing from status for four days while
# the supervisor it starts had never run once.
JOBS=(
  com.stride.console
  com.stride.bridge
  com.stride.pregen
  com.stride.linkedhelper
  com.stride.seo
)

# ——— the brand, in a terminal ————————————————————————————————————
#
# Colours are the library's, in 24-bit ANSI: stride blue, partner lime, alert
# amber, and the muted grey for anything secondary. All of it goes quiet when
# output is not a terminal, so piping this into a file or a log gives plain
# text rather than a screenful of escape codes.

if [[ -t 1 ]]; then
  BLUE=$'\033[38;2;46;48;248m'
  LIME=$'\033[38;2;118;185;0m'
  AMBER=$'\033[38;2;255;169;43m'
  MUTE=$'\033[38;2;138;144;160m'
  INK=$'\033[38;2;230;232;240m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  OFF=$'\033[0m'
else
  BLUE=""; LIME=""; AMBER=""; MUTE=""; INK=""; BOLD=""; DIM=""; OFF=""
fi

ok()   { printf "  ${LIME}●${OFF} %-17s ${MUTE}%s${OFF}\n" "$1" "$2"; }
bad()  { printf "  ${MUTE}○${OFF} %-17s ${AMBER}%s${OFF}\n" "$1" "$2"; }
warn() { printf "  ${AMBER}◐${OFF} %-17s ${MUTE}%s${OFF}\n" "$1" "$2"; }
head_() { printf "\n  ${DIM}%s${OFF}\n" "$1"; }

# The mark: two bars on the same shear as the logo, stepped left as they fall.
banner() {
  printf "\n"
  printf "   ${BLUE}▟██████▛${OFF}\n"
  printf "  ${BLUE}▟██████▛${OFF}     ${BOLD}${INK}STRIDE${OFF}\n"
  printf " ${BLUE}▟██████▛${OFF}      ${MUTE}console · marketing machine${OFF}\n"
  printf "      ${BLUE}▟██████▛${OFF}\n"
  printf "     ${BLUE}▟██████▛${OFF}\n"
  printf "    ${BLUE}▟██████▛${OFF}\n"
}

# The library's accent: five bars fading back. Used once, under the summary.
rule() { printf "  ${BLUE}▰▰▰▰${OFF}${MUTE}▰▰▰${OFF}${DIM}▰▰${OFF}\n"; }

agent_installed() { [[ -f "$HOME/Library/LaunchAgents/$1.plist" ]]; }
agent_loaded()    { launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1; }

# Start an agent whatever state it is in. kickstart alone is not enough: it
# only works on a job launchd already knows about, so anything that has been
# booted out, or never loaded this session, needs bootstrapping first.
start_agent() {
  local job="$1"
  agent_installed "$job" || return 1
  if agent_loaded "$job"; then
    launchctl kickstart -k "gui/$(id -u)/$job" 2>/dev/null
  else
    launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$job.plist" 2>/dev/null
  fi
}

console_up() { curl -sf -o /dev/null --max-time 4 "http://localhost:$CONSOLE_PORT/login"; }
bridge_up()  { curl -sf -o /dev/null --max-time 4 "http://127.0.0.1:$BRIDGE_PORT/ping"; }
lh_debug_up() { curl -sf -o /dev/null --max-time 4 "http://127.0.0.1:$LH_DEBUG_PORT/json/version"; }
lh_running() { pgrep -f "linked-helper.app/Contents/MacOS/linked-helper" >/dev/null; }
# No pipe on purpose. `... | grep -q` looks obvious and is wrong here: grep
# exits the moment it matches, tailscale takes SIGPIPE, and pipefail reports
# that 141 as the pipeline's status. The check then says the funnel is off
# while the site is happily serving.
funnel_on() {
  local status
  status="$(tailscale funnel status 2>/dev/null)"
  [[ "$status" == *"Funnel on"* ]]
}

# "Funnel on" is not the same as "founders can reach it". On 2026-08-09 the node
# was renamed (tailscaled took the DHCP hostname `mac.home`), so the serve config
# still printed the old mac-mini URL, funnel_on stayed true, and the name it
# advertised had no public DNS record at all — the app was down for everyone.
# Ask a public resolver, the way a phone does. Same lesson as the pipefail bug
# above: a check that takes the same shortcut as the thing it checks sees nothing.
# Two resolvers, because one is not evidence: 1.1.1.1 negative-cached the name
# for minutes after the rename was fixed and kept saying the app was down.
funnel_public() {
  local host r
  host="${PUBLIC_URL#https://}"
  for r in 1.1.1.1 8.8.8.8; do
    [[ -n "$(dig +short +time=3 +tries=1 "@$r" "$host" A 2>/dev/null)" ]] && return 0
  done
  return 1
}

# What launchd actually knows about a job, as "state|runs|last exit code".
#
# Reporting that the plist file exists only proves somebody once installed it.
# pregen sat there for days looking installed with runs = 0, because its
# template still said REPLACE_WITH_REPO_PATH and every firing died in the cd.
# A health command that cannot see that is worse than no health command.
job_health() {
  local out
  out="$(launchctl print "gui/$(id -u)/$1" 2>/dev/null)" || { printf 'unloaded||\n'; return; }
  printf '%s|%s|%s\n' \
    "$(sed -n 's/^[[:space:]]*state = \(.*\)$/\1/p' <<<"$out" | head -1)" \
    "$(sed -n 's/^[[:space:]]*runs = \(.*\)$/\1/p' <<<"$out" | head -1)" \
    "$(sed -n 's/^[[:space:]]*last exit code = \(.*\)$/\1/p' <<<"$out" | head -1)"
}

cmd_status() {
  banner
  head_ "services"
  console_up && ok "console" "http://localhost:$CONSOLE_PORT" || bad "console" "down — run: stride"
  if ! funnel_on; then
    bad "funnel" "off — tailscale funnel --bg $CONSOLE_PORT"
  elif ! funnel_public; then
    bad "funnel" "on, but $PUBLIC_URL has no public DNS — run: tailscale set --hostname=mac-mini"
  else
    ok "funnel" "$PUBLIC_URL"
  fi
  bridge_up  && ok "bridge"  "127.0.0.1:$BRIDGE_PORT" || bad "bridge" "down — run: stride"

  if lh_debug_up; then
    ok "linked helper" "open, debugger on $LH_DEBUG_PORT"
  elif lh_running; then
    warn "linked helper" "open WITHOUT the debugger port — quit it, then run: stride"
  else
    bad "linked helper" "closed — run: stride"
  fi

  # The per-account instance holds the campaign window and the AI drafts. It
  # only exists while a LinkedIn session is running, and its port is written
  # fresh each launch, so a stale file does not mean it is alive.
  #
  # Ask for the target list, not just whether the port answers. The launcher
  # shares this file and usually wrote it last, and it answers on its own port
  # perfectly well — so "something replied" reported a running session when
  # none was running. The campaign window's front bundle is the proof.
  # Same string as CAMPAIGN_UI_PATH in bridge/account.mjs; keep them together.
  local port_file="$HOME/Library/Application Support/linked-helper/DevToolsActivePort"
  local acct_port targets
  acct_port="$(head -1 "$port_file" 2>/dev/null || true)"
  targets=""
  if [[ -n "$acct_port" ]]; then
    targets="$(curl -sf --max-time 4 "http://127.0.0.1:$acct_port/json/list" 2>/dev/null || true)"
  fi
  if [[ $targets == *"@linked-helper/front/build/index.html"* ]]; then
    ok "linkedin session" "campaign window reachable on $acct_port"
  elif [[ $targets == *"linkedin.com"* ]]; then
    warn "linkedin session" "running, but the campaign window is closed — open the account window"
  else
    warn "linkedin session" "not running — start the account in Linked Helper to create campaigns"
  fi

  head_ "background jobs"
  local missing=0
  for job in "${JOBS[@]}"; do
    local short="${job#com.stride.}"
    if [[ ! -f "$HOME/Library/LaunchAgents/$job.plist" ]]; then
      bad "$short" "not installed"
      missing=1
      continue
    fi

    local state runs code
    IFS='|' read -r state runs code <<<"$(job_health "$job")"
    case "$state" in
      running)
        ok "$short" "running"
        ;;
      unloaded)
        bad "$short" "installed but not loaded"
        missing=1
        ;;
      *)
        if [[ -z "$runs" || "$runs" == "0" ]]; then
          bad "$short" "loaded, but has never run"
          missing=1
        elif [[ "$code" == "0" ]]; then
          ok "$short" "last run finished cleanly, $runs so far"
        else
          bad "$short" "last run exited $code"
          missing=1
        fi
        ;;
    esac
  done

  # One line that says whether the thing works, so the detail above is only
  # read when it does not.
  echo
  rule
  # A dead background job counts against "everything is up". Serving the site
  # while nothing writes to it is exactly the state this command used to call
  # healthy.
  if console_up && funnel_on && funnel_public && bridge_up && lh_debug_up && [[ $missing -eq 0 ]]; then
    printf "  ${LIME}everything is up${OFF}  ${MUTE}%s${OFF}\n" "$PUBLIC_URL"
  elif console_up; then
    printf "  ${AMBER}the app is up, part of the machine is not${OFF}  ${MUTE}run: stride${OFF}\n"
  else
    printf "  ${AMBER}the app is down${OFF}  ${MUTE}run: stride${OFF}\n"
  fi
  [[ $missing -eq 1 ]] && printf "  ${MUTE}a background job is not doing its work. run: stride install${OFF}\n"
  echo
}

cmd_up() {
  banner
  head_ "starting"

  if console_up; then
    ok "console" "already up"
  else
    if ! start_agent com.stride.console; then
      ( npm run start >/tmp/stride-console.log 2>&1 & )
    fi
    for _ in $(seq 1 20); do console_up && break; sleep 1; done
    console_up && ok "console" "up" || bad "console" "failed — tail /tmp/stride-console.log"
  fi

  if funnel_on; then
    ok "funnel" "on"
  else
    tailscale funnel --bg "$CONSOLE_PORT" >/dev/null 2>&1 \
      && ok "funnel" "published" || bad "funnel" "could not publish"
  fi

  # Linked Helper must carry the debugger port, and the flag only applies to a
  # fresh launch. An instance already open without it is worse than useless.
  if lh_debug_up; then
    ok "linked helper" "already open with the debugger"
  else
    if lh_running; then
      warn "linked helper" "open without the debugger port, restarting it"
      osascript -e 'quit app "linked-helper"' >/dev/null 2>&1
      sleep 4
      pkill -f "linked-helper.app/Contents/MacOS" 2>/dev/null
      sleep 2
    fi
    open -a "$LH_APP" --args --remote-debugging-port=$LH_DEBUG_PORT
    for _ in $(seq 1 25); do lh_debug_up && break; sleep 1; done
    lh_debug_up && ok "linked helper" "up with the debugger" || bad "linked helper" "did not open"
  fi

  if bridge_up; then
    ok "bridge" "already up"
  else
    # Never leave a hand-started bridge next to the agent: only one can hold
    # the port, and the loser dies looking like a broken service.
    pkill -f "bridge/server.mjs" 2>/dev/null
    sleep 1
    if ! start_agent com.stride.bridge; then
      ( node bridge/server.mjs >/tmp/stride-bridge.log 2>&1 & )
    fi
    for _ in $(seq 1 15); do bridge_up && break; sleep 1; done
    bridge_up && ok "bridge" "up" || bad "bridge" "failed — tail /tmp/stride-bridge.log"
  fi

  echo
  rule
  if console_up && bridge_up && lh_debug_up; then
    printf "  ${LIME}ready${OFF}  ${MUTE}%s${OFF}\n\n" "$PUBLIC_URL"
  else
    printf "  ${AMBER}partly up${OFF}  ${MUTE}stride status, or stride logs${OFF}\n\n"
  fi
}

cmd_down() {
  head_ "stopping"
  launchctl bootout "gui/$(id -u)/com.stride.console" 2>/dev/null
  launchctl bootout "gui/$(id -u)/com.stride.bridge" 2>/dev/null
  pkill -f "bridge/server.mjs" 2>/dev/null
  ok "console" "stopped"
  ok "bridge" "stopped"
  echo "  Linked Helper and the funnel are left alone. Quit the app yourself if you want it closed."
  echo
}

cmd_install() {
  banner
  head_ "installing login agents"
  mkdir -p "$HOME/Library/LaunchAgents"

  # The console's password lives only in the installed agent, never in git.
  # Reinstalling would quietly wipe it and drop the console back to the
  # default password, so it is carried across.
  local live_password=""
  live_password="$(/usr/libexec/PlistBuddy -c \
    'Print :EnvironmentVariables:STRIDE_PASSWORD' \
    "$HOME/Library/LaunchAgents/com.stride.console.plist" 2>/dev/null || true)"

  for job in "${JOBS[@]}"; do
    local src="docs/$job.plist"
    [[ -f "$src" ]] || { bad "$job" "no $src in the repo"; continue; }

    # The plists carry an absolute path that only matches this checkout. The
    # second expression is a backstop: a template that still says
    # REPLACE_WITH_REPO_PATH used to install cleanly and then fail every run,
    # because the first pattern simply never matched.
    sed -e "s#/Users/sarveshsingh/stride-console#$ROOT#g" \
        -e "s#REPLACE_WITH_REPO_PATH#$ROOT#g" "$src" \
      > "$HOME/Library/LaunchAgents/$job.plist"

    if [[ "$job" == "com.stride.console" && -n "$live_password" ]]; then
      /usr/libexec/PlistBuddy -c \
        "Add :EnvironmentVariables:STRIDE_PASSWORD string $live_password" \
        "$HOME/Library/LaunchAgents/$job.plist" >/dev/null 2>&1
    fi

    # A stray hand-started process holds the port and the agent then fails to
    # bind, so clear those before handing the job to launchd.
    [[ "$job" == "com.stride.bridge" ]] && pkill -f "bridge/server.mjs" 2>/dev/null

    # bootout returns before launchd has finished tearing the job down, and
    # bootstrapping into that gap fails silently. Wait for it to actually go.
    launchctl bootout "gui/$(id -u)/$job" 2>/dev/null
    for _ in $(seq 1 20); do
      launchctl print "gui/$(id -u)/$job" >/dev/null 2>&1 || break
      sleep 0.25
    done

    if launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$job.plist" 2>/dev/null; then
      ok "$job" "installed and loaded"
    else
      warn "$job" "installed, but would not load — try: stride"
    fi
  done

  echo
  echo "  Everything now starts at login. Tailscale already runs as a system"
  echo "  daemon, so the public address comes back on its own after a reboot."
  echo
}

cmd_logs() {
  echo "Ctrl-C to stop."
  tail -f /tmp/stride-console.log /tmp/stride-bridge.log /tmp/stride-pregen.log 2>/dev/null
}

cmd_link() {
  head_ "linking"
  local target="$HOME/.local/bin/stride"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$ROOT/scripts/stride" "$target"
  if command -v stride >/dev/null 2>&1; then
    ok "stride" "on your PATH — type it from anywhere"
  else
    warn "stride" "linked at $target, but that is not on your PATH"
  fi
  echo
}

# Bare `stride` starts things rather than reporting on them. `up` is safe to
# run when everything is already going: it checks each part and only starts
# what is down, so typing it twice does nothing the second time.
case "${1:-up}" in
  status)  cmd_status ;;
  up)      cmd_up ;;
  down)    cmd_down ;;
  install) cmd_install; cmd_link ;;
  link)    cmd_link ;;
  logs)    cmd_logs ;;
  *)
    echo "usage: stride [up|status|down|install|link|logs]"
    echo "  stride            start everything (safe to repeat)"
    echo "  stride status     what is up, what is not"
    echo "  stride down       stop the console and the bridge"
    echo "  stride install    start it all at login, and link this command"
    echo "  stride logs       tail everything"
    exit 1
    ;;
esac
