<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd template for the SEO agent supervisor. Setup: docs/SEO.md.
     The path below is rewritten to your checkout by `stride install`.

     This is the installed supervisor. Do NOT also run `npm run backend`, or
     two supervisors race on the same JSON store. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stride.seo</string>

  <!-- A login shell so node and the claude CLI are on PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/sarveshsingh/stride-console &amp;&amp; npm run agents</string>
  </array>

  <!-- The supervisor holds its own schedule, so this is a long-lived process
       rather than a calendar job. It catches up after the Mac sleeps, which a
       StartCalendarInterval job silently cannot. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Sonnet is the right tier for this work and keeps overnight runs cheap. -->
    <key>CLAUDE_CLI_MODEL</key>
    <string>sonnet</string>

    <!-- GSC_SITE_URL is deliberately NOT set. stride-ai.nl was registered on
         2026-08-02 as a DOMAIN property, verified by a DNS TXT record in
         Cloudflare, so the identifier is sc-domain:stride-ai.nl — which is
         already the code default in searchConsole.ts. This file used to set
         https://stride-ai.nl/ in anticipation of a URL-prefix property that was
         never created; a scheduled sweep with that set asks the API for a
         property that does not exist and fails only at 03:15, where nobody is
         watching. If a URL-prefix property is ever added, set it here again. -->
  </dict>

  <key>StandardOutPath</key>
  <string>~/Library/Logs/stride-seo.log</string>
  <key>StandardErrorPath</key>
  <string>~/Library/Logs/stride-seo.log</string>
</dict>
</plist>
