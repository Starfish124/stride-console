<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd template for the SEO agent supervisor. Setup: docs/SEO.md.
     The path below is rewritten to your checkout by `stride install`.

     This is the installed supervisor. Do NOT also run `npm run backend`, or
     two supervisors race on the same JSON store. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stride.seo</string>

  <!-- A login shell so node and the claude CLI are on PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/sarveshsingh/stride-console &amp;&amp; npm run agents</string>
  </array>

  <!-- The supervisor holds its own schedule, so this is a long-lived process
       rather than a calendar job. It catches up after the Mac sleeps, which a
       StartCalendarInterval job silently cannot. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Sonnet is the right tier for this work and keeps overnight runs cheap. -->
    <key>CLAUDE_CLI_MODEL</key>
    <string>sonnet</string>

    <!-- stride-ai.nl is registered as a URL-prefix property. The code default
         is sc-domain:stride-ai.nl, which only matches a Domain property, so a
         scheduled sweep without this reads nothing and reports "not measured". -->
    <key>GSC_SITE_URL</key>
    <string>https://stride-ai.nl/</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/stride-seo.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/stride-seo.log</string>
</dict>
</plist>
